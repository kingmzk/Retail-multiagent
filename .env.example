APP_NAME="Retail Customer Support Assistant"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Gemini API Key (Enter your key here)
GEMINI_API_KEY=

# Agent Framework: 'langgraph', 'langchain', or 'adk'
AGENT_FRAMEWORK=langgraph

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_support
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ROOT

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=retail_policies

# MCP Microservices (Stateless HTTP JSON-RPC)
ORDER_MCP_URL=http://localhost:8101/mcp
PRODUCT_MCP_URL=http://localhost:8102/mcp
